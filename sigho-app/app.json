{
  "expo": {
    "name": "Soporte SSU La Paz",
    "slug": "sigho-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ssu-icon-square.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#005096"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bo.ssulpz.soporte",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Usamos Face ID para desbloquear tu sesión de forma segura.",
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para adjuntar fotos de evidencia en los tickets de soporte.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para adjuntar imágenes de respaldo en los tickets.",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para registrar el seguimiento de atención del soporte técnico."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.ssu.appsoporte",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/ssu-icon-square.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/ssu-icon-square.png",
      "name": "Soporte SSU La Paz",
      "shortName": "Soporte SSU",
      "description": "Sistema de Gestión de Soporte Técnico - SSU La Paz",
      "themeColor": "#005096",
      "backgroundColor": "#005096",
      "display": "standalone",
      "startUrl": "/",
      "lang": "es"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#005096",
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para desbloquear tu sesión de forma segura."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite acceder a tus imágenes para adjuntar el acta de soporte.",
          "cameraPermission": "Permite usar la cámara para tomar una foto del acta de soporte."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite registrar tu ubicación al marcar el inicio del trayecto y la llegada al soporte."
        }
      ],
      "./withCleartextTraffic.js"
    ],
    "extra": {
      "eas": {
        "projectId": "1b6509de-d497-4f7d-9abd-75a8521fe79e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1b6509de-d497-4f7d-9abd-75a8521fe79e"
    }
  }
}
